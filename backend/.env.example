# Internal integration (dev scripts: services/fetch-code-blocks.js, compare-detectors)
NOTION_API_KEY=
NOTION_PAGE_ID=

# Public integration (OAuth)
PORT=3000
BASE_URL=http://localhost:3000
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/auth/notion/callback
SESSION_SECRET=
NODE_ENV=development

# Websites that may start Notion auth and receive the result (comma-separated, first = default)
FRONTEND_URLS=https://notion-autolang.vercel.app,http://localhost:5173

# Auto-sync: minimum detection confidence (0-1) before AutoLang changes a block's language
CONFIDENCE_THRESHOLD=0.4
