{
  "manifest_version": 3,
  "name": "Notion AutoLang",
  "version": "0.2.1",
  "description": "Sets the language of Notion code blocks automatically as you write.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Notion AutoLang",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.notion.so/*",
        "https://*.notion.so/*",
        "https://app.notion.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/notionPage.js"
      ],
      "matches": [
        "https://www.notion.so/*",
        "https://*.notion.so/*",
        "https://app.notion.com/*"
      ]
    }
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://www.notion.so/*",
    "https://*.notion.so/*",
    "https://app.notion.com/*",
    "https://zujvelvm42.execute-api.ap-southeast-2.amazonaws.com/*"
  ]
}
